label sucesu-verificar
	menu label Sucesu: VERIFICAR DISCOS (so le, nao altera nada)
	kernel /install.amd/vmlinuz
	append modules=debian-edu-install-udeb desktop=xfce vga=788 initrd=/install.amd/gtk/initrd.gz preseed/file=/cdrom/sucesu/verificar.cfg debian-installer/locale=pt_BR.UTF-8 keyboard-configuration/xkb-keymap=br --- quiet 

